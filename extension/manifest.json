{
  "manifest_version": 3,
  "name": "TabHarbor",
  "version": "1.0.0",
  "description": "Your tabs, in one harbor. Click the toolbar icon to see every open tab grouped by domain — close groups with style, or let AI sort them.",
  "permissions": ["tabs", "activeTab", "storage"],
  "host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "TabHarbor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
